FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
application chtMultiRegionSimpleFoam;
startFrom latestTime;
startTime 0;
stopAt endTime;
endTime 11000;
deltaT 1;
writeControl timeStep;
writeInterval 1000;
purgeWrite 2;
writeFormat ascii;
writePrecision 8;
writeCompression off;
timeFormat general;
timePrecision 8;
runTimeModifiable yes;
