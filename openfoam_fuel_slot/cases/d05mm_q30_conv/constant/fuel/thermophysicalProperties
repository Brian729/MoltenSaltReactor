    {
        muCoeffs<8>     (1.21431605 -0.00516254204 8.96105594e-06 -7.87497715e-09 3.48874372e-12 -6.21636273e-16 0 0);
        kappaCoeffs<8>  (1.05 0 0 0 0 0 0 0);
    }
