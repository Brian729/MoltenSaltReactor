FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
application chtMultiRegionFoam;
startFrom latestTime;
startTime 0;
stopAt endTime;
endTime 100000.0;
deltaT 0.005;
writeControl adjustableRunTime;
writeInterval 50;
purgeWrite 3;
writeFormat ascii;
writePrecision 8;
writeCompression off;
timeFormat general;
timePrecision 8;
runTimeModifiable yes;
adjustTimeStep yes;
maxCo 4;
maxDi 1000;
maxDeltaT 1;
